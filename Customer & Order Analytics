# The following SQL contains queries used to analyse a database with multiple tables containing data of a store's customers and their orders.

-- Query1: unique orders placed in January
SELECT COUNT (DISTINCT orderID)
from BIT_DB.JanSales
WHERE orderID <> "Order ID"
AND LENGTH (orderID) = 6
;

--Query2: Number of orders in January that were for iPhones
SELECT COUNT (DISTINCT orderID)
FROM BIT_DB.JanSales
WHERE Product = "iPhone"
AND orderID <> "Order ID"
AND LENGTH (orderID) = 6
;

--Query3: Customer account numbers for all the orders that were placed in February
SELECT DISTINCT customers.acctnum
FROM BIT_DB.customers
INNER JOIN BIT_DB.FebSales
ON customers.order_id = FebSales.orderID
WHERE orderID <> "Order ID"
AND LENGTH (orderID) = 6
;

--Query4: Cheapest product sold in January
-- In most RDBMS, won't allow you to select an aggregate function like min(price) along with a non-aggregate like 'Product' unless you also have a GROUP BY clause at the end of the query, like this:
SELECT JanSales.Product 
, MIN (price)
FROM BIT_DB.JanSales
GROUP BY Product
ORDER BY price ASC
LIMIT 1
;
-- or you can work around it with a subquery
SELECT distinct JanSales.Product
, JanSales.price
FROM BIT_DB.JanSales
WHERE price IN (SELECT MIN (price) FROM BIT_DB.JanSales)
;


--Query5: total revenue for each product sold in January
SELECT sum(quantity)*price as revenue
,product
FROM BIT_DB.JanSales
GROUP BY product;


--Query6: products sold in February at 548 Lincoln St, Seattle, WA 98101, the number sold, and what was the total revenue
SELECT  Product,
    sum(Quantity),
    sum(Quantity)*price as revenue
FROM BIT_DB.FebSales
WHERE location = '548 Lincoln St, Seattle, WA 98101'
GROUP BY Product
;

--Query7: Number of customers that ordered more than 2 products at a time in February, and their average expenditure
SELECT
count(distinct cust.acctnum),
avg(quantity*price) AS Average_Expenditure
FROM BIT_DB.FebSales Feb
LEFT JOIN BIT_DB.customers cust
ON FEB.orderid=cust.order_id
WHERE Feb.Quantity>2
AND length(orderid) = 6
AND orderid <> 'Order ID';

